{
    "configurations": [
        {
            "name": "Red Pitaya",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/redpitaya-sysroot/usr/include/arm-linux-gnueabihf",
                "${workspaceFolder}/redpitaya-sysroot/usr/include/**",
                "${workspaceFolder}/redpitaya-sysroot/usr/include/c++/11",
                "${workspaceFolder}/redpitaya-sysroot/usr/include/arm-linux-gnueabihf/c++/11",
                "${workspaceFolder}/redpitaya-sysroot/usr/include/c++/11/backward",
                "${workspaceFolder}/redpitaya-sysroot/usr/local/include",
                "${workspaceFolder}/redpitaya-sysroot/usr/include/arm-linux-gnueabihf",
                "${workspaceFolder}/redpitaya-sysroot/usr/include"
            ],
            "defines": [
                "__ARM_SIZEOF_WCHAR_T 4",
                "__ARM_FEATURE_SAT 1",
                "__ARM_ARCH_ISA_ARM 1",
                "__ARMEL__ 1",
                "__ARM_FP 12",
                "__ARM_ASM_SYNTAX_UNIFIED__ 1",
                "__ARM_SIZEOF_MINIMAL_ENUM 4",
                "__ARM_PCS_VFP 1",
                "__ARM_FEATURE_LDREX 15",
                "__ARM_FEATURE_UNALIGNED 1",
                "__ARM_FEATURE_QBIT 1",
                "__ARM_ARCH_PROFILE 65",
                "__VFP_FP__ 1",
                "__ARM_32BIT_STATE 1",
                "__ARM_FEATURE_CLZ 1",
                "__ARM_ARCH_ISA_THUMB 2",
                "__ARM_ARCH 7",
                "__ARM_ARCH_7A__ 1",
                "__ARM_FEATURE_SIMD32 1",
                "__ARM_FEATURE_COPROC 15",
                "__ARM_FEATURE_DSP 1",
                "__ARM_EABI__ 1"
            ],
            "compilerPath": "",
            "intelliSenseMode": "linux-gcc-arm",
            "compilerArgs": [
                "-mfloat-abi=hard"
            ],
            "cStandard": "gnu17",
            "cppStandard": "gnu++17"
        }
    ],
    "version": 4
}